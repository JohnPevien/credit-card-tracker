# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Next.js Configuration
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: Set environment (development, production, etc.)
# development / production
NODE_ENV=development

# Site-wide password protection
# Set a strong password here to enable site-wide protection
# Leave empty to disable password protection
SITE_PASSWORD=""

# Keep-alive — prevents free-tier Supabase from pausing after 7 days inactivity
# Vercel Cron: vercel.json → /api/keep-alive at 05:00 UTC daily (was every 2 days, now daily + cache-busted multi-table ping)
# GitHub Actions backup: .github/workflows/keep-alive.yml at 17:00 UTC (12h offset)
# If CRON_SECRET is set, Vercel sends Authorization: Bearer $CRON_SECRET and the route verifies it.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# Optional but recommended: service_role key bypasses RLS and guarantees DB hit.
# Get from Supabase Dashboard → Project Settings → API → service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=""

# For GitHub Actions (optional if APP_URL differs from default)
# APP_URL=https://your-project.vercel.app
