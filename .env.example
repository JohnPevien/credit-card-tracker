# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site password protection (optional; bypassed in development)
SITE_PASSWORD=

# Keep-alive — prevents free-tier Supabase from pausing after 7 days
# Vercel Cron pings /api/keep-alive daily at 05:00 UTC (vercel.json).
# If CRON_SECRET is set, Vercel sends `Authorization: Bearer $CRON_SECRET` and the endpoint verifies it.
# GitHub Actions also pings at 17:00 UTC as fallback; see .github/workflows/keep-alive.yml.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional but recommended: service_role bypasses RLS and guarantees a real DB hit even if anon is blocked.
# Get it from Supabase Dashboard → Project Settings → API → service_role (keep secret, server-only).
SUPABASE_SERVICE_ROLE_KEY=

# For GitHub Actions fallback (optional): public URL of your Vercel deployment
# APP_URL=https://your-project.vercel.app
